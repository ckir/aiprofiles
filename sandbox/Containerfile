# Disposable test environment for agent-profile (CONTRIBUTING.md "Testing in a sandbox").
#
# Built fresh for every run by sandbox/run.sh and deleted afterwards. It holds the toolchains a test needs
# (Rust, Node/npm, Python/uv) but never a coding agent: probes install agents inside the running container, so
# every measurement starts from a clean install.

# NODE COMES FROM THE OFFICIAL IMAGE, NOT FROM DEBIAN. Trixie ships Node v20.19.2, and one of the twelve
# agents cannot start on it: pi's bundle imports `enableCompileCache` from `node:module`, which needs
# Node 22+, so `pi --version` died with a SyntaxError and the probe failed before measuring anything.
# Measured on v24.21.0 — the current LTS, "Krypton" — pi reports 0.87.0 and the six other agents this
# image installs from npm all report their versions normally.
#
# COPIED FROM THE IMAGE RATHER THAN DOWNLOADED, and the alternatives were rejected for specific reasons.
# A pinned tarball from nodejs.org would have to name an architecture, and this image is built for
# aarch64 too (`sandbox/run.sh` maps `uname -m` onto NEXTEST_PLATFORM); a hardcoded `linux-x64` there
# fails at runtime with `exec format error` rather than at build time, on the machine least likely to be
# testing it. The engine resolves the right architecture from the manifest list for free.
#
# NodeSource's apt repository was rejected on a sharper point: its setup script is `curl | bash` AS ROOT,
# at build time, in the image that later acts as the measurement apparatus. Everything downstream of this
# file rests on `/etc/sudoers.d/probe-to-agent` granting `probe` exactly one power over `agent` and
# nothing the other way; code running as root while that file is being written can rewrite it, and a
# compromised toolchain here means the measured party could forge the measurements taken of it. The
# runtime uid split is what this image is FOR, and it is only as good as the build that creates it.
#
# Pinned by the MANIFEST LIST digest, so the pin and multi-architecture resolution coexist: the digest
# names the index, and the engine still picks amd64 or arm64 beneath it. Dependabot covers cargo and
# github-actions in this repository but NOT containers, so this digest is maintained by hand, exactly as
# the base image's below always has been.
FROM docker.io/library/node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS node

FROM docker.io/library/debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132

ARG RUST_TOOLCHAIN=stable
ARG NEXTEST_VERSION=0.9.144
# `linux` (x86_64) or `linux-arm` (aarch64); sandbox/run.sh passes the host's.
ARG NEXTEST_PLATFORM=linux
ARG UV_VERSION=0.12.15

# `sudo` is here for exactly one rule, written below: it is what lets the unprivileged harness reach the
# second unprivileged user. Without it `probe` cannot become `agent` at all — only root may `su`.
#
# `unzip` is here for the kiro probe, and it was missing: the vendor installer at cli.kiro.dev refuses
# with "Missing required dependencies: unzip" and cleans up, so `sandbox/run.sh probe kiro` failed at the
# INSTALL step — before any measurement — in this image and in CI alike. Nothing caught it because no
# probe had been run against a real agent. `xz-utils` beside it is the same kind of dependency for a
# different archive format; an installer's unpacker is part of the toolchain, not part of the agent.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git pkg-config python3 sudo unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

# `nodejs` and `npm` are deliberately ABSENT from that list; they come from the stage above. Both
# directories are needed and neither is redundant: the executables in `bin` are symlinks into
# `lib/node_modules`, so copying only `bin` would leave npm, npx and corepack dangling. Verified in a
# built image: node v24.21.0, npm 11.19.0, npx 11.19.0, corepack 0.36.0, and `ldd $(command -v node)`
# reports no missing shared library — bookworm's glibc is older than trixie's, and binaries link forward.
COPY --from=node /usr/local/bin /usr/local/bin
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

# The node image keeps yarn under /opt, which is NOT copied above, so those two links arrive already
# broken. They are removed rather than repaired: nothing here uses yarn, and a broken symlink sitting on
# PATH is the kind of thing that surfaces much later as a confusing "yarn: No such file or directory"
# from an agent's install script, pointing at the agent rather than at this file. MEASURED in the built
# image before this line existed: `find /usr/local/bin -xtype l` returned exactly these two.
RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg

# uv goes to a shared location rather than into a home directory. `sandbox/run.sh test` runs as `probe`
# while the aider probe's `uv tool install` now runs as `agent`, and one copy under either home would be
# on only one of the two PATHs.
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" \
        | env UV_NO_MODIFY_PATH=1 UV_INSTALL_DIR=/usr/local/bin sh

# TWO unprivileged users, because one is not a boundary: code running at the harness's uid can rewrite
# the harness's bookkeeping, and the repository is public so it knows where that is.
#
#   probe  the harness. Owns /home/probe/.probe-out and /home/probe/.probe-state at mode 700, takes the
#          snapshots, computes the deltas, writes the step records, decides the run's exit status.
#   agent  everything measured — the INSTALL included, because `npm install --global <pkg>` runs the
#          package's own install scripts, which are agent-controlled code running before the agent
#          binary ever launches. An install as `probe` would hand an attacker the harness uid before
#          the boundary applied.
#
# Neither is root. `probe ALL=(agent)` is the whole of the privilege granted, and it is one-directional:
# `agent` is given nothing. `visudo -c` checks the rule at BUILD time, so a malformed one fails the build
# instead of surfacing as "command not found" in every later step.
#
# The two share the supplementary group `probe-share`, and /home/agent is group `probe-share` and setgid,
# so everything the agent creates under it carries a group the harness is in and can therefore be read by
# the snapshot that has to measure it. The harness's own two directories stay 700, so the shared group
# does not reopen the hole it exists to close.
#
# /home/probe is made traversable explicitly because Debian's useradd honours HOME_MODE from
# /etc/login.defs (0700 in trixie) and the agent is launched with the HARNESS's cwd, /home/probe/work.
RUN groupadd probe-share \
    && useradd --create-home --shell /bin/bash --groups probe-share probe \
    && useradd --create-home --shell /bin/bash --groups probe-share agent \
    && chmod 0755 /home/probe \
    && chgrp probe-share /home/agent \
    && chmod 2775 /home/agent \
    && echo 'probe ALL=(agent) NOPASSWD: ALL' > /etc/sudoers.d/probe-to-agent \
    && chmod 0440 /etc/sudoers.d/probe-to-agent \
    && visudo -cf /etc/sudoers.d/probe-to-agent

USER probe
WORKDIR /home/probe
# The HARNESS's environment. It deliberately does NOT name the agent's bin directories: the agent's
# binaries are reachable only through the privilege switch, so a launch that forgot to take it fails
# loudly with 127 instead of quietly running the agent at the harness's uid. The agent's own PATH and
# npm prefix are passed across the switch by `common.sh`'s probe_as_agent, not inherited from here.
ENV PATH=/home/probe/.cargo/bin:/home/probe/.local/bin:$PATH \
    NPM_CONFIG_PREFIX=/home/probe/.local \
    CARGO_TERM_COLOR=never

# Rust and nextest belong to the harness: `sandbox/run.sh test` runs `cargo nextest` as `probe`, and
# none of that moves.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "$RUST_TOOLCHAIN" --component rustfmt,clippy \
    && curl -LsSf "https://get.nexte.st/${NEXTEST_VERSION}/${NEXTEST_PLATFORM}" | tar zxf - -C /home/probe/.cargo/bin
